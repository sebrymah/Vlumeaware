# --- core ---
DATABASE_URL="postgresql://vlumeaware:vlumeaware@localhost:5432/vlumeaware?schema=public"
JWT_SECRET="change-me-to-at-least-32-random-characters"
JWT_TTL="8h"
PORT=3001
CORS_ORIGINS="http://localhost:3000"

# How many reverse proxies sit in front of the API. Express ignores
# X-Forwarded-For until it is told how many hops to trust, so with this wrong
# every caller shares one rate-limit bucket — the 10/min login limit becomes a
# global 10/min and anyone can lock an account out. It must be the EXACT hop
# count, never `true` (trusting every hop lets a client forge its own address).
# 1 = Render / a single load balancer. 0 = nothing in front, or something that
# already sets req.ip. Defaults to 1.
TRUST_PROXY=1

# --- queue ---
# The Redis instance must run with maxmemory-policy=noeviction. Managed hosts
# often default to allkeys-lru, which can silently evict queued sends.
#
# A single REDIS_URL is preferred on managed hosts (Upstash / Railway / Render
# hand one out, often rediss:// with a password). The discrete values below are
# for local Docker. TLS is automatic for rediss:// or when REDIS_TLS=true.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=
SEND_CONCURRENCY=5

# Where rate-limit counters are kept: "redis" or "memory". Left unset, Redis is
# used as soon as REDIS_URL or REDIS_HOST is configured, and an in-process
# counter otherwise. "memory" is for development only — the count does not
# outlive the process, so behind more than one instance the effective limit
# becomes limit × instances.
RATE_LIMIT_STORE=

# The API refuses to start if the database schema is behind the code in the
# image. Set to 1 only to override that deliberately during a staged rollout.
SKIP_SCHEMA_CHECK=

# --- migrations ---
# Migrations are applied on boot by default. That is safe behind multiple
# instances: Prisma's schema engine takes a Postgres advisory lock before
# applying anything, so concurrent starts queue rather than collide. Set to 0
# only if you have a pre-deploy command doing it, or if the application's
# database role has no DDL rights.
MIGRATE_ON_BOOT=

# How long a boot migration may take before the process gives up and fails the
# deploy. Defaults to 5 minutes.
MIGRATE_TIMEOUT_MS=

# Prisma documents an escape hatch, PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK, which
# turns off the lock described above. Do not set it: without the lock, two
# instances starting at once can apply the same migration concurrently.

# --- sender addresses ---
# SIMULATION_FROM_ADDRESS sends the fake phishing. Genuine mail must NOT come
# from it, or staff learn to trust the address they are being trained to
# distrust. Three separate pools, all on a domain verified with the provider:
#   SIMULATION_FROM_ADDRESS   fake phishing        (reputation intentionally poor)
#   NOTIFICATION_FROM_ADDRESS certificates, training invites
#   DIGEST_FROM_ADDRESS       the weekly client digest
# Unset values fall back to defaults on vlumesec.com; an address on a domain
# the provider has not verified is rejected and the send fails silently.
NOTIFICATION_FROM_ADDRESS=
DIGEST_FROM_ADDRESS=

# How often an opted-in client is emailed the digest. Default 7 days. The
# worker polls hourly and checks each tenant's last_digest_sent_at, so this
# is the real cadence — shorten it only to demo the feature.
DIGEST_INTERVAL_MS=

# --- report-a-phish intake ---
# Shared secret the inbound-mail pipeline must present in the
# X-Vlumeaware-Intake-Secret header when it POSTs a forwarded message to
# /intake/phish-report. The endpoint is public by necessity (the pipeline has
# no user session), so this is its only authentication; without it, anyone
# could write phish-report rows against any enrolled employee. Unset in
# production, the endpoint refuses every request; unset in development it is
# allowed so the flow can still be exercised locally, with a warning logged.
INTAKE_SHARED_SECRET=

# --- mail gateway allow-list published to client admins ---
# Egress IPs their IT must allow for simulated phish to reach the inbox.
# Microsoft 365's Advanced Delivery phishing-simulation policy requires the
# sending domain AND the IP, so the domain alone is not enough. Comma
# separated; entries that are not an IP or CIDR are dropped rather than shown.
ALLOWLIST_IPS=

# --- object storage (uploaded videos and signed agreements) ---
# Supabase takes priority over S3; with neither set, uploads go to local disk
# and are lost on restart. SUPABASE_SERVICE_ROLE_KEY must be the service_role
# JWT (starts "eyJ", two dots) from Project Settings -> API -> Legacy API keys.
# The newer sb_secret_... keys are not JWTs and are rejected by Storage with
# "Invalid Compact JWS". Create the bucket manually as a PRIVATE bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=training-videos

# --- AI assistant (scenario drafts + report narratives) ---
# AI_PROVIDER picks the backend: "deepseek" or "anthropic". Left unset,
# whichever key is present is used, DeepSeek first when both are.
# Note what leaves your infrastructure: scenario prompts carry the client's
# industry and any free-text context, report prompts carry the client's name
# and campaign results.
AI_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
CLAUDE_MODEL="claude-sonnet-5"

# --- email ---
# Leave MAILER unset in dev: sends are logged, never delivered.
MAILER=
SES_CONFIGURATION_SET="vlumeaware-simulation"
SIMULATION_FROM_ADDRESS="no-reply@vlumeaware-trk.io"
AWS_REGION="eu-west-1"

# --- domains ---
# Tracking domain must stay separate from vlumetech.com.ng.
TRACKING_BASE_URL="http://localhost:3001"
PUBLIC_WEB_URL="http://localhost:3000"

# --- storage ---
S3_BUCKET=
